# Copy the relevant lines into Railway > your service > Variables.
# Nothing here is read automatically; Railway injects these as real env vars.

# ---------------------------------------------------------------- required --

# Which settings module to load. Without this the app boots in DEVELOPMENT
# settings (DEBUG on, SQLite, no security headers).
DJANGO_SETTINGS_MODULE=config.settings_production

# Django signing key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# config.settings_production refuses to start without it.
BARCODE_SECRET_KEY=replace-me-with-a-generated-50-character-key

# ---------------------------------------------------------------- provided --
# Railway sets these for you - do not add them by hand:
#   DATABASE_URL               when a Postgres service is attached
#   PORT                       the port gunicorn must bind
#   RAILWAY_PUBLIC_DOMAIN      the generated <name>.up.railway.app hostname
#   RAILWAY_VOLUME_MOUNT_PATH  when a Volume is attached (MEDIA_ROOT follows it)

# ---------------------------------------------------------------- optional --

# Extra hostnames, comma separated. The Railway domain is allowed automatically;
# add a custom domain here.
# DJANGO_ALLOWED_HOSTS=inventory.example.com,www.inventory.example.com

# Set to 0 only if you terminate TLS yourself and the redirect loops.
# DJANGO_SECURE_SSL_REDIRECT=1

# HSTS. Leave at 0 until the custom domain is confirmed working over HTTPS,
# then raise it (e.g. 31536000). Hard to undo in browsers once set.
# DJANGO_HSTS_SECONDS=0

# DEBUG in production leaks tracebacks and settings. Leave unset.
# DJANGO_DEBUG=0

# DJANGO_LOG_LEVEL=INFO
